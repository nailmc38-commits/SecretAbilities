{
  "schemaVersion": 1,
  "id": "autoenchanter",
  "version": "${version}",
  "name": "AutoEnchanter",
  "description": "Self-contained client-side enchantment builder and RNG manipulation GUI for Minecraft 1.21.11.",
  "authors": ["Secret_gamer38"],
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.secret.autoenchanter.AutoEnchanterClient"
    ]
  },
  "jars": [
    {
      "file": "META-INF/jars/clientcommands-2.13.2.jar"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "fabric-api": "*",
    "minecraft": "1.21.11",
    "java": ">=21"
  }
}
